# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). See README.md for the full setup walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Bypasses Row Level Security,
# so it's only used from trusted server-side code (if/when we need it).
SUPABASE_SERVICE_ROLE_KEY=
